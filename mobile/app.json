{
  "expo": {
    "name": "مركز المعلم",
    "slug": "mualimhub",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mualimhub",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aalmershed.mualimhub",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar"
        ]
      }
    },
    "android": {
      "package": "com.aalmershed.mualimhub",
      "adaptiveIcon": {
        "backgroundColor": "#5f978f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f4f0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "forcesRTL": true,
          "supportedLocales": {
            "ios": [
              "ar"
            ],
            "android": [
              "ar"
            ]
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج مركز المعلم الوصول للصور لإضافتها في ملف الإنجاز والشهادات.",
          "cameraPermission": "يحتاج مركز المعلم الكاميرا لتصوير الشواهد وإضافتها في ملف الإنجاز.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "forcesRTL": true,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "60ede0ad-7713-4f18-8f0d-b4114756b73a"
      }
    },
    "owner": "azalmershed"
  }
}
