# الدومين بدون https (مثال: injaz.sa) — يستخدمه Caddy لإصدار شهادة HTTPS
DOMAIN=example.com
# رابط الموقع الكامل — تُبنى عليه روابط الشواهد ورموز QR والصور داخل ملفات PDF
PUBLIC_URL=https://example.com

# بريدك أنت: سجّل به في الموقع لتصبح مديرًا وتفتح /admin
ADMIN_EMAIL=you@example.com

# الدفع: moyasar = بوابة ميسر | manual = التفعيل يدوي من لوحة الإدارة
#        mock = تجريبي يفعّل بدون دفع — لا تستخدمه في موقع عام
PAYMENT_PROVIDER=moyasar

# مفاتيح ميسر (لوحة ميسر ← الإعدادات ← مفاتيح API)
# المفتاح العام يبدأ بـ pk_ ، والسري يبدأ بـ sk_ — السري لا يُشارك مع أحد ولا يُرفع على GitHub
MOYASAR_PUBLISHABLE_KEY=pk_live_xxx
MOYASAR_SECRET_KEY=sk_live_xxx
# كلمة سر الإشعارات: نفس القيمة تضعها في لوحة ميسر عند إضافة Webhook على الرابط https://دومينك/payments/moyasar/webhook
MOYASAR_WEBHOOK_SECRET=ضع_هنا_نصا_عشوائيا_طويلا
# طرق الدفع (مفصولة بفاصلة): creditcard، stcpay، applepay (Apple Pay يحتاج توثيق الدومين في لوحة ميسر)
MOYASAR_METHODS=creditcard
PRICE_MONTHLY=29
PRICE_YEARLY=199
# التسجيل والاستخدام مجاني؛ الاشتراك مطلوب لتنزيل PDF فقط. ضع رقمًا هنا لمنح أيام تنزيل مجانية للمسجلين الجدد
TRIAL_DAYS=0

FILE_MAX_MB=25
STORAGE_QUOTA_MB=1000
