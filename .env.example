# الدومين بدون https (مثال: injaz.sa) — يستخدمه Caddy لإصدار شهادة HTTPS
DOMAIN=example.com
# رابط الموقع الكامل — تُبنى عليه روابط الشواهد ورموز QR والصور داخل ملفات PDF
PUBLIC_URL=https://example.com

# بريدك أنت: سجّل به في الموقع لتصبح مديرًا وتفتح /admin
ADMIN_EMAIL=you@example.com

# الدفع: manual = التفعيل يدوي من لوحة الإدارة (آمن حتى نربط بوابة دفع)
#        mock   = تجريبي يفعّل بدون دفع — لا تستخدمه في موقع عام
PAYMENT_PROVIDER=manual
PRICE_MONTHLY=29
PRICE_YEARLY=199
# التسجيل والاستخدام مجاني؛ الاشتراك مطلوب لتنزيل PDF فقط. ضع رقمًا هنا لمنح أيام تنزيل مجانية للمسجلين الجدد
TRIAL_DAYS=0

FILE_MAX_MB=25
STORAGE_QUOTA_MB=1000
